{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compress Images",
  "mainBinaryName": "compress-images-app",
  "identifier": "io.github.alpandi15.compress-images",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Compress Images",
        "url": "index.html",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 540,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Compress images in files and folders",
    "longDescription": "Compress images one by one or whole folders at a time. Results go into a compressed/ folder; originals are never touched.",
    "copyright": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
