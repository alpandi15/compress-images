{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main and quick-mode windows",
  "windows": ["main", "quick"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir"
  ]
}
